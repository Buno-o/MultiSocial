{
  "name": "multisocial",
  "productName": "MultiSocial",
  "version": "1.7.5",
  "description": "Todas as suas redes sociais em um só app, com abas, PiP e mais.",
  "main": "src/main.js",
  "author": "Buno",
  "license": "MIT",
  "repository": "https://github.com/Buno-o/MultiSocial",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.buno.multisocial",
    "productName": "MultiSocial",
    "copyright": "Buno",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MultiSocial",
      "artifactName": "${productName}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.0.0"
  }
}
